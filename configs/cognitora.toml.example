# Cognitora example configuration.
#
# All sections are optional. Values shown below are the built-in defaults
# (see rust/libraries/cgn-core/src/config.rs).
#
# Place this file at /etc/cognitora/cognitora.toml and reference it from
# every binary's --config flag, or set COGNITORA_CONFIG=/etc/...

[cluster]
name      = "default"
data_dir  = "/var/lib/cognitora"
etcd      = ["127.0.0.1:2379"]
# node_id is derived from a stable file on first boot if unset.
#
# State backend: "etcd" (default) or "gossip". Gossip mode discovers nodes
# over a UDP mesh (chitchat) and needs no external services. Control-plane
# features (cordon/drain, confirmed-KV feed, policy hot-reload) stay
# etcd-only; see docs/architecture/gossip.md.
# state_backend    = "etcd"
# gossip_seeds     = []                # any subset of live members, e.g. ["10.0.0.1:7946"]
# gossip_listen    = "0.0.0.0:7946"    # UDP socket the gossip member binds
# gossip_advertise = ""                # address peers use to reach this member
                                       # (required when gossip_listen is a wildcard
                                       # on multi-host clusters; defaults to gossip_listen)

[security]
require_mtls   = true
ca_file        = "/etc/cognitora/pki/ca.crt"
cert_file      = "/etc/cognitora/pki/leaf.crt"
key_file       = "/etc/cognitora/pki/leaf.key"
client_ca_file = "/etc/cognitora/pki/ca.crt"

[auth]
# When false, the OpenAI HTTP surface is open. CI / dev only.
enabled         = true
api_keys_file   = "/etc/cognitora/keys.txt"
oidc_issuer     = ""        # e.g. "https://your-idp.example.com"
oidc_audience   = ""        # JWT `aud`
# Requests need a scope (`chat`, `embed` or `*`). Set false to migrate keys.
enforce_scopes  = true
# oidc_groups_claim = "groups"
# [auth.oidc_group_scopes]
# ml-team = ["chat", "embed", "tenant:ml"]
# Persists key usage across restarts; without it budgets reset on restart.
# usage_file = "/var/lib/cognitora/usage.json"
#
# Key file lines: `<key-or-sha256> <comma-separated scopes>`. Besides `chat`
# and `embed`, scopes are policy: `model:<name>` (repeatable, `*` suffix
# allowed), `tenant:<id>`, `tpm:<tokens per minute>`, `budget:<tokens>`.

# ---- Router (combined gateway + orchestrator) ------------------------------

[router]
listen_http  = "0.0.0.0:8080"   # OpenAI-compatible API
listen_grpc  = "0.0.0.0:7070"   # internal RPC (mTLS)
listen_admin = "127.0.0.1:9091" # /metrics, /healthz, /readyz
worker_threads = 0              # 0 = num_cpus
drain_timeout = "30s"           # in-flight work allowed after SIGTERM
first_token_timeout = "300s"    # retry elsewhere after this long with no token
max_body_mb = 32                # base64 images count against this
kv_tenant_isolation = true      # tenants never share cached prefixes

[router.score_weights]
kv       = 0.55
load     = 0.25
power    = 0.10
capacity = 0.10

[router.admission]
max_queue            = 4096   # cap on requests in flight per (model,role)
ttft_slo             = "800ms"
wait_queue_per_tenant = 64    # parked per tenant at the cap; 0 rejects at once
wait_timeout         = "10s"  # longest a parked request waits before a 429

[router.rate_limit]
rps   = 50
burst = 100
# Only these peers may set X-Forwarded-For. Empty ignores the header.
trusted_proxies = []          # e.g. ["10.0.0.0/8"]

[router.cascade]
enabled              = false
confidence_threshold = -1.0   # mean logprob; below this -> escalate

[router.disagg]
enabled                 = false
colocate_below_tokens   = 256

# ---- Carbon-aware admission (optional) -------------------------------------
# Polls grid carbon intensity and rejects low-priority HTTP requests
# (X-CGN-Priority: low) while intensity exceeds the threshold.

# [carbon]
# enabled             = false
# provider            = "static"          # static | electricitymaps | watttime
# zone                = "DE"
# api_token           = ""
# static_intensity    = 300.0             # gCO2/kWh when provider = "static"
# intensity_threshold = 450.0
# poll_interval       = "5m"

# ---- Agent (per-GPU-host engine supervisor) --------------------------------

[agent]
listen_grpc      = "0.0.0.0:7071"
listen_admin     = "127.0.0.1:9091"
ready_probe_url  = "http://127.0.0.1:8000/v1/models"
ready_timeout    = "120s"
heartbeat        = "5s"

# ---- Engine driver --------------------------------------------------------
# `kind` selects which engine the agent spawns:
#   "vllm"          — `vllm serve <model> --tensor-parallel-size <N> ...`
#   "sglang"        — `python -m sglang.launch_server --model-path <model> --tp <N> ...`
#   "llama_cpp"     — `python -m llama_cpp.server` or a standalone `llama-server` binary
#   "openai_compat" — no spawn; agent only proxies to engine.url

[engine]
kind = "vllm"
url  = "http://127.0.0.1:8000"

# Engine-side KV offload backend. One of:
#   "none"     — no engine-side connector (default)
#   "nixl"     — NIXL only, for prefill->decode handoff
#   "lmcache"  — LMCache (vLLM only); auto-stacks with NIXL in disagg
#   "hicache"  — SGLang Hierarchical Cache (sglang only)
#   "kvbm"     — NVIDIA Dynamo KVBM (vLLM only)
# See docs/architecture/kv-strategy.md for the compatibility matrix.
kv_offload = "none"

[engine.vllm]
binary     = "vllm"
extra_args = ["--enable-chunked-prefill"]

[engine.sglang]
binary              = "python"
host                = "127.0.0.1"
port                = 8000
context_length      = 4096
mem_fraction_static = 0.85
extra_args          = ["--enable-radix-cache"]

[engine.llama_cpp]
binary       = "python"
mode         = "python_server"   # or "binary"
host         = "127.0.0.1"
port         = 8000
n_ctx        = 4096
n_threads    = 4
n_gpu_layers = 0                  # -1 = offload everything to GPU

# ---- MLX-LM (Apple Silicon only; optional alternative to openai_compat) ---
# Spawns: python3 -m mlx_lm.server --model … --host … --port …
# [engine]
# kind = "mlx"
# url  = "http://127.0.0.1:8090"
# kv_offload = "none"
#
# [engine.mlx_lm]
# binary     = "python3"
# host       = "127.0.0.1"
# port       = 8090
# extra_args = []

# ---- KV cache daemon -------------------------------------------------------

[kv]
listen      = "0.0.0.0:7072"
quic_listen = "0.0.0.0:7073"
# quic_server_name = "cognitora"   # every peer cert needs this SAN under mTLS
# allow_insecure_quic = false      # needed for plain QUIC on a public address
ssd_dir     = "/var/lib/cognitora/kv/ssd"
index_dir   = "/var/lib/cognitora/kv/index"
ram_gib     = 8
ssd_gib     = 256

# ---- Metrics aggregator ----------------------------------------------------

[metrics]
listen_admin    = "0.0.0.0:9092"
scrape_interval = "10s"
redfish_url     = ""           # https://bmc.example/redfish/v1
redfish_user    = ""
redfish_pass_file = ""

# Federation targets. Every entry is fetched on `scrape_interval`;
# the union is exposed under `/federate` with a `cgn_target = "<name>"`
# label injected on every line so an upstream Prometheus can scrape
# this single endpoint and still see per-component metrics.
#
# scrape_targets = [
#   { name = "router",      url = "http://router.cognitora.local:9091/metrics" },
#   { name = "agent-1",     url = "http://node-1.cognitora.local:9091/metrics" },
#   { name = "kvcached-rk0", url = "http://node-1.cognitora.local:9092/metrics" },
# ]
scrape_targets = []

# ---- Models declared up front (optional; can also be done at runtime) ------

[models.llama3-8b]
hf_repo  = "meta-llama/Meta-Llama-3-8B-Instruct"
tp       = 1
dtype    = "bfloat16"
cascade  = []                  # []  | ["llama3-8b","llama3-70b"]
# Real tokens make prefix routing and usage accurate. One of:
# tokenizer      = "/models/llama3-8b/tokenizer.json"
# tokenizer_repo = "meta-llama/Meta-Llama-3-8B-Instruct"
# LoRA adapters, requested by name as a model id (vLLM and SGLang):
# [models.llama3-8b.lora]
# sql = "/models/lora/sql"

[models.llama3-70b]
hf_repo  = "meta-llama/Meta-Llama-3-70B-Instruct"
tp       = 4
dtype    = "bfloat16"
