{
  "annotations": {
    "list": []
  },
  "description": "Cognitora \u2014 router, agent, kvcached overview. Mounted by the Helm chart as a ConfigMap with label grafana_dashboard=1.",
  "editable": false,
  "graphTooltip": 0,
  "panels": [
    {
      "type": "stat",
      "title": "Router p99 routing decision (\u00b5s)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(cgn_router_routing_decision_seconds_bucket[5m])) by (le)) * 1e6",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "\u00b5s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 350
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          }
        }
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Mean prefix overlap",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(cgn_router_prefix_overlap_ratio_sum[5m])) / sum(rate(cgn_router_prefix_overlap_ratio_count[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.4
              },
              {
                "color": "green",
                "value": 0.55
              }
            ]
          }
        }
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Router QPS by status",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(cgn_router_chat_requests_total[1m])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Inflight by model",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(cgn_router_admission_inflight) by (model)",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Cluster watts",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "max by (node) (cgn_cluster_node_power_watts)",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "TTFT p99 by model",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(cgn_router_chat_ttft_seconds_bucket[5m])) by (le, model))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": [
    "cognitora"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "",
  "title": "Cognitora overview",
  "uid": "cgn-overview",
  "version": 1
}
